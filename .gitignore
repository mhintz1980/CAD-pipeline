# ---- proprietary customer / vendor CAD ----
# Never commit source CAD. It is the customer's data, it is large, and it is
# copied here read-only purely as a working input.
source/

# ---- derived binaries ----
# Blend/GLB outputs are regenerable from source/ via tools/*.py, and several
# exceed GitHub's 100 MB per-file hard limit (the vendored engine alone is
# 144 MB). The scene lineage is documented in ASTRA-HANDOFF-*.md instead.
out/
*.blend
*.blend1

# ---- generated renders ----
# Regenerable with tools/render_v*.py. Kept out so the repo stays small.
reports/views/
reports/validate-*/
reports/astra-preview/_warmup/

# ---- cloud run artifacts ----
# Modal/cloud runs (2026-09-18 and later) drop regenerable meshes and render
# bulk under reports/; JSON/MD readbacks and stdout logs stay tracked. The
# engine STLs alone are ~75 MB and re-export via tools/astra_engine_export.py;
# beauty/wide renders regenerate via tools/beauty_reference_20260918.py and
# tools/astra_modal_wide.py.
*.stl
reports/astra-modal-engine/run-*/*.png
reports/astra-modal-wide/**/lookdev/*.png
reports/reference-beauty-20260918/**/*.png

# ---- local environment ----
.venv/
__pycache__/
*.pyc
